# App
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
TIMEZONE=Asia/Shanghai
CORS_ORIGINS=*

# Database
DATABASE_URL=sqlite:///./running_agent.db

# Strava OAuth
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
STRAVA_ATHLETE_ID=
STRAVA_WEBHOOK_VERIFY_TOKEN=
STRAVA_WEBHOOK_CALLBACK_URL=

# Optional AI (OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Email
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
EMAIL_FROM=
EMAIL_TO=

# Reminder settings
DEFAULT_REMINDER_HOUR=19
DEFAULT_REMINDER_MINUTE=0
